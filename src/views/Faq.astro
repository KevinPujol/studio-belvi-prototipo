---
import { md } from '../lib/text';
import { type Lang } from '../lib/i18n';
import { faq } from '../lib/content';
interface Props { lang: Lang }
const f = faq(Astro.props.lang);
---
<section class="faq-section page-top">
  <div class="container">
    <div class="section-header">
      <h2 set:html={md(f.title)} />
      <p set:html={md(f.intro)} />
    </div>
    {f.items.map((it, i) => (
      <div class="faq-item">
        <button class="faq-question" type="button" aria-expanded="false" aria-controls={`faq-${i}`} set:html={md(it.question)} />
        <div class="faq-answer" id={`faq-${i}`}><p set:html={md(it.answer)} /></div>
      </div>
    ))}
  </div>
</section>
<script>
  document.querySelectorAll<HTMLButtonElement>('.faq-question').forEach((b) => b.addEventListener('click', () => {
    const item = b.closest('.faq-item')!;
    const open = item.classList.toggle('open');
    b.setAttribute('aria-expanded', String(open));
  }));
</script>
