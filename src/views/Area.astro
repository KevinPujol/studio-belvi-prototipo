---
import { md, plain } from '../lib/text';
import FamilyCard from '../components/FamilyCard.astro';
import { asset, type Lang } from '../lib/i18n';
import { gallery, families } from '../lib/content';
interface Props { lang: Lang; t: Record<string, string>; area: 'memorabilia' | 'scenography' | 'immersion' }
const { lang, t, area } = Astro.props;
const g = gallery(area, lang);
const fam = families(lang).filter((f) => f.area === area);
---
<section class="page-top">
  <div class="container">
    <div class="section-header reveal">
      <h2 set:html={md(g.title)} />
      {g.text && <p set:html={md(g.text)} />}
    </div>
    <div class="portfolio-grid cols-3">
      {g.cards.map((c) => (
        <div class="portfolio-item reveal" data-flip tabindex="0" role="button" aria-pressed="false">
          <div class="portfolio-card">
            <div class="portfolio-card-front"><img src={asset(c.image)} alt={plain(c.caption) || plain(g.title)} style={c.position ? `object-position: ${c.position}` : undefined} loading="lazy" decoding="async" /></div>
            <div class="portfolio-card-back"><h3 set:html={md(c.caption)} /></div>
          </div>
        </div>
      ))}
    </div>
    {fam.length > 0 && (
      <div class="subsection">
        <h3 class="subsection-title reveal">{t.area_packs_title}</h3>
        <div class="family-grid">{fam.map((f) => <FamilyCard family={f} lang={lang} t={t} />)}</div>
      </div>
    )}
  </div>
</section>
