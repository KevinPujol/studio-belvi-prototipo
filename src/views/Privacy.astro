---
import { type Lang } from '../lib/i18n';
import { privacy } from '../lib/content';
interface Props { lang: Lang }
const p = privacy(Astro.props.lang);
---
<section class="page-top">
  <div class="container prose" style="max-width:820px">
    <div class="section-header"><h2>{p.title}</h2></div>
    {p.draft_notice && <p class="draft-notice">{p.draft_notice}</p>}
    {p.sections.map((s) => <><h3>{s.heading}</h3><p>{s.body}</p></>)}
  </div>
</section>
