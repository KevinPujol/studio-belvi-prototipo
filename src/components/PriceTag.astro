---
import { priceText, type Price } from '../lib/price';
import type { Lang } from '../lib/i18n';
interface Props { price?: Price | null; lang: Lang; vat?: boolean; class?: string }
const { price, lang, vat = true, class: cls = '' } = Astro.props;
const text = priceText(price, lang, { vat });
---
{text && <span class={`price ${cls}`} data-price>{text}</span>}
