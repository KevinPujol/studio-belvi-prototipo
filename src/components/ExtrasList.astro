---
import { md } from '../lib/text';
import PriceTag from './PriceTag.astro';
import type { Lang } from '../lib/i18n';
import type { Extra } from '../lib/content';
interface Props { extras: Extra[]; lang: Lang; t: Record<string, string> }
const { extras, lang, t } = Astro.props;
const groups = (['additional_piece', 'combo', 'addon', 'support'] as const)
  .map((kind) => ({ kind, items: extras.filter((e) => e.kind === kind) }))
  .filter((g) => g.items.length);
---
{groups.map((g) => (
  <div class="panel reveal subsection">
    <h3>{t[`extras_${g.kind}`] ?? t.extras_addon}</h3>
    <div class="extras">
      {g.items.map((e) => (
        <div class="extra">
          <span><span class="label">{e.label}</span>{e.description && <span class="desc" set:html={md(e.description)} />}</span>
          <PriceTag price={e.price} lang={lang} vat={e.price?.vat_mode === 'included'} />
        </div>
      ))}
    </div>
    {(() => { const priced = g.items.filter((e) => e.price && e.price.amount != null); return priced.length > 0 && priced.every((e) => e.price!.vat_mode === 'excluded'); })() && <p class="small-note">{t.extras_vat_note}</p>}
  </div>
))}
