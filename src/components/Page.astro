---
// Renders one route in one language (used by src/pages/[...route].astro and src/pages/[lang]/index.astro).
import Base from '../layouts/Base.astro';
import Home from '../views/Home.astro';
import CreativeDirection from '../views/CreativeDirection.astro';
import Level from '../views/Level.astro';
import Packs from '../views/Packs.astro';
import Family from '../views/Family.astro';
import Area from '../views/Area.astro';
import Portfolio from '../views/Portfolio.astro';
import Faq from '../views/Faq.astro';
import Privacy from '../views/Privacy.astro';
import type { Lang } from '../lib/i18n';
import type { RouteDef } from '../lib/routes';
import { ui, family, level, gallery, faq, catalog, privacy } from '../lib/content';

const { lang, def } = Astro.props as { lang: Lang; def: RouteDef };
const t = ui(lang);
const strip = (s = '') => s.replace(/<[^>]+>/g, '');
let title = '';
let description = '';
let image: string | undefined;
switch (def.view) {
  case 'creative-direction': title = catalog(lang).cd_title; description = catalog(lang).cd_intro; break;
  case 'level': { const l = level(def.key!, lang)!; title = l.name; description = l.description; break; }
  case 'packs': title = catalog(lang).pp_title; description = catalog(lang).pp_intro; break;
  case 'family': { const f = family(def.key!, lang)!; title = f.name; description = f.tagline; image = f.cover_image ?? undefined; break; }
  case 'area': title = strip(gallery(def.key!, lang).title); break;
  case 'portfolio': { const g = gallery('portfolio', lang); title = strip(g.title); description = strip(g.text); break; }
  case 'faq': title = strip(faq(lang).title); break;
  case 'privacy': title = privacy(lang).title; break;
}
---
<Base lang={lang} route={def.route} title={title} description={description} image={image}>
  <main>
    {def.view === 'home' && <Home lang={lang} t={t} />}
    {def.view === 'creative-direction' && <CreativeDirection lang={lang} t={t} />}
    {def.view === 'level' && <Level lang={lang} t={t} slug={def.key!} />}
    {def.view === 'packs' && <Packs lang={lang} t={t} />}
    {def.view === 'family' && <Family lang={lang} t={t} slug={def.key!} />}
    {def.view === 'area' && <Area lang={lang} t={t} area={def.key as 'memorabilia'} />}
    {def.view === 'portfolio' && <Portfolio lang={lang} />}
    {def.view === 'faq' && <Faq lang={lang} />}
    {def.view === 'privacy' && <Privacy lang={lang} />}
  </main>
</Base>
