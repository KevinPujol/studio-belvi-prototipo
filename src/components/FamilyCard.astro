---
import { md } from '../lib/text';
import PriceTag from './PriceTag.astro';
import { asset, pageUrl, type Lang } from '../lib/i18n';
import type { Family } from '../lib/content';
interface Props { family: Family; lang: Lang; t: Record<string, string>; showFeatured?: boolean }
const { family: f, lang, t, showFeatured = false } = Astro.props;
const featured = f.packs.filter((p) => p.featured).map((p) => p.name);
---
<a href={pageUrl(`packs/${f.slug}`, lang)} class="family-card reveal" data-area={f.area}>
  {f.cover_image && <img src={asset(f.cover_image)} alt={f.name} style={f.cover_position ? `object-position: ${f.cover_position}` : undefined} loading="lazy" decoding="async" width="800" height="600" />}
  <div class="body">
    <h3>{f.name}</h3>
    <p class="tagline" set:html={md(f.tagline)} />
    {showFeatured && featured.length > 0 && <p class="featured">{t.featured_packs}: {featured.join(' · ')}</p>}
    <PriceTag price={f.price_from} lang={lang} />
  </div>
</a>
